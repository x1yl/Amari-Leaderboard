# Required: Amari API key (https://amaribot.com/dashboard)
AMARI_API_KEY=

# Optional: public origin used for metadata, sitemap and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: lets the site resolve server names/icons for servers that hide
# their Discord widget. The bot only needs to be in the server.
DISCORD_BOT_TOKEN=
